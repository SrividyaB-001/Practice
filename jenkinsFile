pipeline {
    agent any
    stages {
       stage('checkout') {
          git config --global http.sslVerify false
          checkout scm
}
        stage('Build') {
            steps {
                echo "Build Stage"
            }
        }
        stage('Deploy') {
            steps {
                echo "Deploy Stage"
                script {
                sh '''
                    for var in 0 1 2 
                    do 
                    mkdir test$var
                    echo "test$var"
                    '''
                }
            }
        }
    }
}
